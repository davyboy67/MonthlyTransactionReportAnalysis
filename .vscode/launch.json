{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Backend",
            "port": 9229,
            "restart": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "node-terminal",
            "name": "Run Dev Server",
            "command": "npm run dev",
            "serverReadyAction": {
                "pattern": "started on port",
                "action": "debugWithChrome"
            }
        }
    ],
    "compounds": [
        {
            "name": "Dev and Attach",
            "configurations": [
                "Run Dev Server",
                "Attach to Backend"
            ]
        }
    ]
}