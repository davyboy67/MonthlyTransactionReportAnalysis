{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Backend",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "-r", "ts-node/register",
                "-r", "tsconfig-paths/register"
            ],
            "args": ["src/server.ts"],
            "cwd": "${workspaceFolder}/packages/backend",
            "sourceMaps": true,
            "smartStep": true,
            "skipFiles": [  
                "<node_internals>/**",
                "**/*.js"
            ],
            "env": {
                "TS_NODE_PROJECT": "${workspaceFolder}/packages/backend/tsconfig.json",
                "TS_NODE_TRANSPILE_ONLY": "true"
            }
        },
        {
            "type": "node",
            "request": "attach",
            "name": "Attach to Backend",
            "port": 9229,
            "restart": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}