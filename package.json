{
  "name": "transaction-report-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest",
    "tests": "jest --runInBand",
    "lint": "eslint .",
    "backend:dev": "npm run dev --workspace=@transaction-report/backend",
    "backend:build": "npm run build --workspace=@transaction-report/backend",
    "backend:start": "npm run start --workspace=@transaction-report/backend",
    "frontend:dev": "npm run dev --workspace=@transaction-report/frontend",
    "frontend:build": "npm run build --workspace=@transaction-report/frontend",
    "frontend:preview": "npm run preview --workspace=@transaction-report/frontend",
    "shared:build": "npm run build --workspace=@transaction-report/shared",
    "shared:dev": "concurrently -k \"tsc -p packages/shared/tsconfig.cjs.json -w\" \"tsc -p packages/shared/tsconfig.esm.json -w\"",
    "build:all": "npm run shared:build && npm run backend:build && npm run frontend:build",
    "dev": "concurrently -k \"npm run shared:dev\" \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:lambda": "npm run backend:build && node scripts/bundle-lambda.js",
    "deploy:lambda-manual": "npm run backend:lambda && echo 'Upload packages/backend/dist/lambda-bundle/ to AWS Lambda Console'",
    "deploy": "cd packages/frontend && npm run build && gh-pages -d dist -r https://github.com/davyboy67/MonthlyTransactionReportAnalysis.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.2.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/axios": "^0.14.4",
    "@types/dotenv": "^8.2.3",
    "@types/pg": "^8.16.0",
    "aws-lambda": "^1.0.7",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26"
  }
}
