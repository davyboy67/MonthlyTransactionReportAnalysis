// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ReportAnalysis {
  id            Int           @id @default(autoincrement())
  report_date   DateTime      @db.Date
  total_income  Decimal       @db.Decimal(10, 2)
  total_expenses Decimal      @db.Decimal(10, 2)
  transactions  Transaction[]

  @@map("reportanalysis")
}

model Transaction {
  id                 Int            @id @default(autoincrement())
  report_analysis_id Int
  date               DateTime       @db.Date
  description        String
  amount             Decimal        @db.Decimal(10, 2)
  category           String
  merchant           String
  reportAnalysis     ReportAnalysis @relation(fields: [report_analysis_id], references: [id])

  @@map("transaction")
}
